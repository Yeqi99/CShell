import{connectDesktop}from'../src/core/desktop-client';import{readFileSync,writeFileSync}from'node:fs';import{join}from'node:path';import{spawnSync}from'node:child_process';import{createDecipheriv,X509Certificate}from'node:crypto';import{ClientVault}from'../src/core/client/identity';import{ClientProvider}from'../src/core/client/provider';
const root=join(process.env.APPDATA!,'CShell Pro'),active=JSON.parse(readFileSync(join(root,'account-profile.json'),'utf8')).active,dir=join(root,'account-profiles',active);let key:Buffer|undefined;const blob=readFileSync(join(dir,'client-controller','identity.enc'),'utf8');const decrypt=(text:string,k:Buffer)=>{const b=Buffer.from(text,'base64');if(b.subarray(0,3).toString()!=='v10')throw Error('Unknown vault format');const d=createDecipheriv('aes-256-gcm',k,b.subarray(3,15));d.setAuthTag(b.subarray(-16));return Buffer.concat([d.update(b.subarray(15,-16)),d.final()]).toString()};
for(const f of[join(dir,'Local State'),join(root,'Local State')])try{const encrypted=JSON.parse(readFileSync(f,'utf8')).os_crypt.encrypted_key;const command="Add-Type -AssemblyName System.Security; $b=[Convert]::FromBase64String('"+encrypted+"'); $k=[Security.Cryptography.ProtectedData]::Unprotect($b[5..($b.Length-1)],$null,[Security.Cryptography.DataProtectionScope]::CurrentUser); [Console]::Write([Convert]::ToBase64String($k))";const r=spawnSync('powershell.exe',['-NoProfile','-NonInteractive','-Command',command],{encoding:'utf8',windowsHide:true});if(r.status!==0)continue;const candidate=Buffer.from(r.stdout.trim(),'base64');decrypt(blob,candidate);key=candidate;break;}catch{}
if(!key)throw Error('Saved controller identity unavailable');const provider=new ClientProvider(new ClientVault(join(dir,'client-controller'),{encrypt:async()=>{throw Error('Read only');},decrypt:async v=>decrypt(v,key!)}),()=>{});const login=JSON.parse(decrypt(readFileSync(join(dir,'cloud-sync.enc'),'utf8'),key));provider.cloudLease=async(id)=>{const response=await fetch('https://shell.canp.ai/api/v1/devices/lease',{method:'POST',headers:{Authorization:'Bearer '+login.session.token,'Content-Type':'application/json'},body:JSON.stringify({deviceId:id}),signal:AbortSignal.timeout(30000)});if(!response.ok){const detail=await response.json().catch(()=>({}));throw Error('Cloud lease HTTP '+response.status+' '+String(detail.error?.message??detail.error??detail.message??detail.code??'').slice(0,160));}return(await response.json()).relay;};try{await provider.load();const config=JSON.parse(readFileSync(join(dir,'config.json'),'utf8'));const target=config.profiles.find((p:any)=>p.name==='德威云');const device=provider.cloudExport().find(d=>d.deviceId===target?.id);if(!device)throw Error('Target missing');console.log({target:device.name,accountManaged:!!device.accountManaged});let desktop:any;try{const ticket:any=await provider.call(device.deviceId,{method:'desktop.open',params:{quality:{fps:10,bitrate:1000000,display:0,adaptive:false},control:true,transport:'management'}} ,AbortSignal.timeout(30000));const stream=await provider.openDesktopStream(device.deviceId);desktop=await connectDesktop(ticket,{host:device.host,expectedHostIdentity:device.deviceId,stream});let frames=0,bytes=0,closed='';desktop.on('frame',(f:any)=>{frames++;bytes+=f.data.length;desktop.ack(f.id)});desktop.on('closed',(v:any)=>closed=String(v));desktop.on('notice',(v:any)=>console.log({notice:v}));const until=Date.now()+15000;while(frames<3&&!closed&&Date.now()<until)await new Promise(r=>setTimeout(r,50));console.log({frames,bytes,closed,video:desktop.videoInfo});if(frames){if(desktop.videoInfo?.inputAcknowledgment){await desktop.inputConfirmed({kind:'secure-attention'});console.log({sasAcknowledged:true});await new Promise(r=>setTimeout(r,2000));}else{desktop.input({kind:'secure-attention'});console.log({pointerSent:true,acknowledgmentAvailable:false});}}}catch(e){console.log({failure:String(e)})}finally{await desktop?.close()}}finally{provider.dispose();key.fill(0);}



