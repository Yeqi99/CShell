import{connectDesktop}from'../src/core/desktop-client';import{readFileSync,writeFileSync}from'node:fs';import{join}from'node:path';import{spawnSync}from'node:child_process';import{createDecipheriv,X509Certificate}from'node:crypto';import{ClientVault}from'../src/core/client/identity';import{ClientProvider,dial}from'../src/core/client/provider';
const root=join(process.env.APPDATA!,'CShell Pro'),active=JSON.parse(readFileSync(join(root,'account-profile.json'),'utf8')).active,dir=join(root,'account-profiles',active);let key:Buffer|undefined;const blob=readFileSync(join(dir,'client-controller','identity.enc'),'utf8');const decrypt=(text:string,k:Buffer)=>{const b=Buffer.from(text,'base64');if(b.subarray(0,3).toString()!=='v10')throw Error('Unknown vault format');const d=createDecipheriv('aes-256-gcm',k,b.subarray(3,15));d.setAuthTag(b.subarray(-16));return Buffer.concat([d.update(b.subarray(15,-16)),d.final()]).toString()};
for(const f of[join(dir,'Local State'),join(root,'Local State')])try{const encrypted=JSON.parse(readFileSync(f,'utf8')).os_crypt.encrypted_key;const command="Add-Type -AssemblyName System.Security; $b=[Convert]::FromBase64String('"+encrypted+"'); $k=[Security.Cryptography.ProtectedData]::Unprotect($b[5..($b.Length-1)],$null,[Security.Cryptography.DataProtectionScope]::CurrentUser); [Console]::Write([Convert]::ToBase64String($k))";const r=spawnSync('powershell.exe',['-NoProfile','-NonInteractive','-Command',command],{encoding:'utf8',windowsHide:true});if(r.status!==0)continue;const candidate=Buffer.from(r.stdout.trim(),'base64');decrypt(blob,candidate);key=candidate;break;}catch{}
if(!key)throw Error('Saved controller identity unavailable');const provider=new ClientProvider(new ClientVault(join(dir,'client-controller'),{encrypt:async()=>{throw Error('Read only');},decrypt:async v=>decrypt(v,key!)}),()=>{});const login=JSON.parse(decrypt(readFileSync(join(dir,'cloud-sync.enc'),'utf8'),key));provider.cloudLease=async(id)=>{const response=await fetch('https://shell.canp.ai/api/v1/devices/lease',{method:'POST',headers:{Authorization:'Bearer '+login.session.token,'Content-Type':'application/json'},body:JSON.stringify({deviceId:id}),signal:AbortSignal.timeout(30000)});if(!response.ok){const detail=await response.json().catch(()=>({}));throw Error('Cloud lease HTTP '+response.status+' '+String(detail.error?.message??detail.error??detail.message??detail.code??'').slice(0,160));}return(await response.json()).relay;};try{await provider.load();const config=JSON.parse(readFileSync(join(dir,'config.json'),'utf8'));const target=config.profiles.find((p:any)=>p.name==='德威云');const device=provider.cloudExport().find(d=>d.deviceId===target?.id);if(!device)throw Error('Target missing');const vault=new ClientVault(join(dir,'client-controller'),{encrypt:async()=>{throw Error('read only')},decrypt:async v=>decrypt(v,key!)});const signal=AbortSignal.timeout(600000);const relay=await provider.cloudLease!(device.deviceId);const channel=await dial({...device,relay},await vault.identity(),()=>{},signal);try{await channel.request('auth',{name:'CShell diagnostics',password:device.accountPassword});const call=(method:string,params:any={})=>channel.request('manage',{method,params},60000).catch(e=>{throw Error(method+': '+e.message)}) as Promise<any>;
const exec=async(command:string)=>{const r:any=await channel.request('exec',{shell:'powershell',command,timeoutMs:45000},60000);if(r.exitCode!==0)throw Error(r.stderr||r.stdout);return r.stdout.trim()};
console.log(await exec(readFileSync(process.argv[2],'utf8')));}finally{channel.socket.destroy();}}finally{provider.dispose();key.fill(0);}